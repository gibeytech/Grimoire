* {
  font-family: "JetBrainsMono Nerd Font";
  font-size: 13px;
}

window#waybar {
  background: rgba(20, 20, 24, 0.92);
  color: #ffffff;
}

#workspaces button {
  padding: 0 8px;
  color: #bbbbbb;
  background: transparent;
  border: none;
}

#workspaces button.active {
  color: #00ff99;
}

#clock,
#pulseaudio,
#network,
#battery,
#tray {
  padding: 0 10px;
}
